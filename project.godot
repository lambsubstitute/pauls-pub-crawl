; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Paul's Pub Crawl"
run/main_scene="res://game/rooms/church_st/room_church_st.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Globals="*uid://cdxigkeqn304"
Cursor="*uid://c2pqh7ajiuiy0"
E="*uid://rda8wggldt5o"
R="*uid://4olwvs312slq"
C="*uid://br5uptw0tyjgx"
I="*uid://cvv3d45bxnpg3"
D="*uid://dqwxul2xoc1r4"
A="*uid://dj25u5jo2lvyb"
G="*uid://blk6nfpfiqrd2"
T="*uid://30lm6k5s368s"

[display]

window/size/viewport_width=320
window/size/viewport_height=200
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/popochiu/editor/gizmos/plugin.cfg", "res://addons/popochiu/editor/importers/plugin.cfg", "res://addons/popochiu/plugin.cfg", "res://addons/ppc_bootstrap/plugin.cfg")

[internationalization]

